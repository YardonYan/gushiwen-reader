      "k": "通假字",
      "w": "故患有所不辟也",
      "n": "辟同避，躲避。"
    },
    {
      "k": "通假字",
      "w": "万钟则不辩礼义而受之",
      "n": "辩同辨，分辨、辨别。"
    },
    {
      "k": "通假字",
      "w": "所识穷乏者得我与",
      "n": "得同德，感恩、感激；与同欤，语气词。"
    },
    {
      "k": "通假字",
      "w": "乡为身死而不受",
      "n": "乡通向，从前、先前。"
    },
    {
      "k": "古今异义",
      "w": "一豆羹",
      "n": "豆是古代盛食物的器皿，不是豆类植物。"
    },
    {
      "k": "古今异义",
      "w": "可以得生者",
      "n": "可以是能够用来，不是表示许可的现代汉语可以。"
    },
    {
      "k": "古今异义",
      "w": "是亦不可以已乎",
      "n": "已是停止，不是已经。"
    },
    {
      "k": "一词多义",
      "w": "为",
      "n": "故不为苟得也、何不为也中的为是做；为宫室之美中的为是为了；今为宫室之美为之中两个为分别是为了、做。"
    },
    {
      "k": "一词多义",
      "w": "于",
      "n": "有甚于生者中的于是比；万钟于我何加焉中的于是对。"
    },
    {
      "k": "古今异义",
      "w": "本心",
      "n": "指天性、本来的心，即舍生取义之心，不是一般的心思。"
    }
  ]
