        { "w": "，", "punct": true },
        { "w": "吞", "p": "tūn", "g": "吞下，这里写长江之水流入洞庭湖。" },
        { "w": "长江", "p": "cháng jiāng", "g": "长江。" },
        { "w": "，", "punct": true },
