        { "w": "诗赋", "p": "shī fù", "g": "诗歌和辞赋。" },
        { "w": "于", "p": "yú", "g": "介词，在。" },
        { "w": "其", "p": "qí", "g": "代词，指岳阳楼的。" },
        { "w": "上", "p": "shàng", "g": "上面。" },
