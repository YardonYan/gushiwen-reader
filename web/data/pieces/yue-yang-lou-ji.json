        { "w": "，", "punct": true },
        { "w": "政通人和", "p": "zhèng tōng rén hé", "g": "政事顺利，百姓和乐。", "ch": { "政": "政事", "通": "顺利", "人": "百姓", "和": "和乐" } },
        { "w": "，", "punct": true },
        { "w": "百废具兴", "p": "bǎi fèi jù xīng", "g": "各种荒废的事业都兴办起来。具，同俱，全、都。", "hard": true, "ch": { "百": "各种", "废": "荒废的事业", "具": "同俱，全、都", "兴": "兴办" }, "d": "具是通假字，同俱。百废具兴写滕子京治理有方，不是一百件废事。" },
        { "w": "。", "punct": true }
      ],
