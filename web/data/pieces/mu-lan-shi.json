        { "w": "大点兵", "p": "dà diǎn bīng", "g": "大规模征兵。" },
        { "w": "，", "punct": true },
        { "w": "军书", "p": "jūn shū", "g": "军中的文书。" },
        { "w": "十二卷", "p": "shí èr juàn", "g": "许多卷。十二表示多，不是确数。", "hard": true, "d": "十二与后面的十二年、十二转都表示数量多，不要机械理解为确数。" },
        { "w": "，", "punct": true },
        { "w": "卷卷", "p": "juàn juàn", "g": "每一卷。卷，量词。" },
        { "w": "有", "p": "yǒu", "g": "有。" },
        { "w": "爷名", "p": "yé míng", "g": "父亲的名字。爷，这里指父亲。" },
        { "w": "。", "punct": true }
      ],
      "tr": "昨天夜里看见征兵的文书，可汗要大规模征兵，军书有许多卷，每一卷上都有父亲的名字。",
      "note": "点明从军缘由。十二卷、卷卷极力铺陈征兵的繁多，爷爷的名字便使压力落到木兰一家身上。",
      "key": true,
      "exam": "理解性默写 · 军情紧急与父亲在册"
    },
    {
      "t": [
        { "w": "阿爷", "p": "ā yé", "g": "父亲。阿，词头，无实义。", "hard": true, "d": "爷在诗中是父亲，不是祖父；阿是称呼前的词头。" },
        { "w": "无", "p": "wú", "g": "没有。" },
        { "w": "大儿", "p": "dà ér", "g": "成年的儿子。" },
        { "w": "，", "punct": true },
        { "w": "木兰", "p": "mù lán", "g": "主人公。" },
        { "w": "无", "p": "wú", "g": "没有。" },
        { "w": "长兄", "p": "zhǎng xiōng", "g": "哥哥。长，年长的。" },
        { "w": "，", "punct": true },
        { "w": "愿", "p": "yuàn", "g": "愿意。" },
        { "w": "为", "p": "wèi", "g": "为了，替。" },
        { "w": "市", "p": "shì", "g": "买。名词作动词。", "hard": true, "d": "市在这里活用为动词，读 shì，意为购买。" },
        { "w": "鞍马", "p": "ān mǎ", "g": "马鞍和马，这里泛指战马和马具。" },
        { "w": "，", "punct": true },
        { "w": "从此", "p": "cóng cǐ", "g": "从这时起。" },
        { "w": "替爷征", "p": "tì yé zhēng", "g": "代替父亲出征。" },
        { "w": "。", "punct": true }
      ],
      "tr": "父亲没有成年的儿子，木兰也没有哥哥。她愿意买来鞍马，从此替父亲出征。",
      "note": "木兰的抉择出于孝心与担当。为读 wèi，市是名词作动词，两项都是默写与词义考查重点。",
      "key": true,
      "exam": "内容理解 · 代父从军；词类活用 · 市"
    },
    {
