{
  "id": "mu-lan-shi",
  "title": "木兰诗",
  "author": "北朝民歌",
  "dynasty": "南北朝",
  "grade": "七下",
  "genre": "诗",
  "syllabus": "课标",
  "motif": "horse",
  "authorIntro": "《木兰诗》是南北朝时期北方民歌的代表作，和《孔雀东南飞》合称乐府双璧。它讲述木兰女扮男装、代父从军的故事，语言明白如话，善用复沓、排比、顶真等手法。作品既塑造了木兰英勇善战、热爱和平生活的形象，也表现了古代劳动人民勤劳勇敢、淳朴善良的品格。",
  "background": "北魏时期，北方战事频繁，百姓要承担兵役和繁重劳役。木兰的故事在民间长期流传，后来被乐府机构采集整理。诗中可汗大点兵、军书十二卷等描写，反映了战时征调的紧迫；征战十年后木兰辞官还乡，则集中表现了人民对安定生活的向往。",
  "lines": [
    {
      "t": [
        { "w": "唧唧", "p": "jī jī", "g": "织机声。一说为叹息声。", "hard": true, "ch": { "唧": "拟声词用字" }, "d": "教材一般解释为织机声，也有注本理解为叹息声。联系下文惟闻女叹息，两种解释都能推动叙事。" },
        { "w": "复", "p": "fù", "g": "又，接着。" },
        { "w": "唧唧", "p": "jī jī", "g": "又传来唧唧的声音。" },
        { "w": "，", "punct": true },
        { "w": "木兰", "p": "mù lán", "g": "主人公的名字。" },
        { "w": "当户", "p": "dāng hù", "g": "对着门户。当，对着；户，门。", "hard": true, "ch": { "当": "面对着", "户": "门" } },
        { "w": "织", "p": "zhī", "g": "织布。" },
        { "w": "。", "punct": true },
        { "w": "不闻", "p": "bù wén", "g": "听不见。不，表否定；闻，听见。" },
        { "w": "机杼", "p": "jī zhù", "g": "织布机。杼，织布的梭子。", "hard": true, "ch": { "杼": "织布用的梭子" } },
        { "w": "声", "p": "shēng", "g": "声音。" },
        { "w": "，", "punct": true },
        { "w": "惟闻", "p": "wéi wén", "g": "只听见。惟，只。" },
        { "w": "女", "p": "nǚ", "g": "女子，这里指木兰。" },
        { "w": "叹息", "p": "tàn xī", "g": "因忧思而叹气。" },
        { "w": "。", "punct": true }
      ],
      "tr": "织机声唧唧作响，木兰对着门织布。忽然听不见织机声，只听见她在叹息。",
      "note": "开篇用声音变化设置悬念。不复闻机杼声与惟闻女叹息形成对照，引出下文代父从军的原因。"
    },
    {
      "t": [
        { "w": "问女", "p": "wèn nǚ", "g": "问木兰。" },
        { "w": "何所思", "p": "hé suǒ sī", "g": "想的是什么。何，什么；所思，所思念的。" },
        { "w": "，", "punct": true },
        { "w": "问女", "p": "wèn nǚ", "g": "又问木兰。" },
        { "w": "何所忆", "p": "hé suǒ yì", "g": "思念的是什么。忆，思念。" },
        { "w": "。", "punct": true },
        { "w": "女亦", "p": "nǚ yì", "g": "木兰回答说：我也。亦，也。" },
        { "w": "无所思", "p": "wú suǒ sī", "g": "没有想什么。" },
        { "w": "，", "punct": true },
        { "w": "女亦", "p": "nǚ yì", "g": "我也。" },
        { "w": "无所忆", "p": "wú suǒ yì", "g": "没有思念什么。" },
        { "w": "。", "punct": true }
      ],
      "tr": "问她在想什么，问她思念什么。木兰说：我也没有想什么，也没有思念什么。",
      "note": "问答复沓，先故作平淡，再揭开军书到来的缘由。两次设问推动情节，也使歌谣节奏鲜明。"
    },
    {
      "t": [
        { "w": "昨夜", "p": "zuó yè", "g": "昨天夜里。" },
        { "w": "见", "p": "jiàn", "g": "看见。" },
        { "w": "军帖", "p": "jūn tiě", "g": "征兵的文书。帖，文告。", "hard": true, "ch": { "帖": "文告" }, "d": "这里的帖读 tiě，指文书，不读 tiē 或 tiè。" },
        { "w": "，", "punct": true },
