        { "w": "爷娘去", "p": "yé niáng qù", "g": "辞别父母出发。" },
        { "w": "，", "punct": true },
        { "w": "暮宿", "p": "mù sù", "g": "傍晚住宿。暮，傍晚。" },
        { "w": "黄河边", "p": "huáng hé biān", "g": "黄河边上。" },
