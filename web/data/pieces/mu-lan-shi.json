        { "w": "买", "p": "mǎi", "g": "购买。" },
        { "w": "辔头", "p": "pèi tóu", "g": "驾驭牲口用的嚼子和缰绳。", "hard": true, "ch": { "辔": "缰绳" } },
        { "w": "，", "punct": true },
        { "w": "北市", "p": "běi shì", "g": "北边的集市。" },
        { "w": "买", "p": "mǎi", "g": "购买。" },
        { "w": "长鞭", "p": "cháng biān", "g": "长长的马鞭。" },
        { "w": "。", "punct": true }
      ],
      "tr": "在东边集市买骏马，在西边集市买鞍垫，在南边集市买辔头，在北边集市买长鞭。",
      "note": "四句排比，从东西南北铺开准备行装的场面。既写战马装备齐全，也显出木兰行动的利落。",
      "key": true,
      "exam": "赏析 · 排比；直接默写 · 出征准备"
    },
    {
